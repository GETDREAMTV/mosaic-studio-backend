# Copy this file to ".env" (same folder) and fill in your real key.
# ".env" is in .gitignore -- it is never committed, zipped, or sent anywhere.
#
# Get a key from https://openrouter.ai/keys (requires an OpenRouter
# account with some credit -- every image generation call spends real
# credit, there is no free image model).
#
# This key is ONLY used by backend/cover_generator.py, and ONLY when you
# click "generate cover" in the UI. It is read from this file on your
# own machine and sent directly to openrouter.ai -- never to Claude or
# anywhere else.

OPENROUTER_API_KEY=sk-or-v1-your-real-key-here
